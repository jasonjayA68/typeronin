# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.
#
# Supabase — Project Settings → API (or → API Keys on newer dashboards).
# Both values are safe to expose to the browser: the publishable/anon key is
# protected by Row Level Security, not by secrecy. Never put the *secret*
# (service_role) key in a NEXT_PUBLIC_ variable — that key bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Newer dashboards call this the "publishable" key (sb_publishable_...).
# Older ones call it the "anon" key (a long JWT). Either works — set one.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# Media library (optional). Unset, the panel still loads and the library says
# what is missing instead of failing — but nothing can be uploaded.
#
# This is the secret key described above, and the warning was not rhetorical: it
# bypasses Row Level Security and can read and write every row in the project.
# It has NO NEXT_PUBLIC_ prefix and must never gain one. src/lib/supabase/admin.ts
# is `server-only`, so an accidental client import fails the build rather than
# shipping this to the browser.
#
# It exists because uploading is gated on a `media:write` row in our own tables,
# which a storage policy cannot read. See supabase/media-bucket.sql for the whole
# argument — and run that file once to create the bucket, or uploads will 404.
#
# Newer dashboards call this the "secret" key (sb_secret_...).
# Older ones call it "service_role" (a long JWT). Either works — set one.
SUPABASE_SECRET_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Database — the SAME Supabase project as above.
# Dashboard → Project Settings → Database → Connection string.
#
# Two URLs, and the distinction matters:
#
#   DATABASE_URL  Transaction pooler, port 6543. Used by the app at runtime.
#                 Append ?pgbouncer=true so Prisma stops using prepared
#                 statements, which the pooler cannot hold across a transaction.
#
#   DIRECT_URL    Direct connection, port 5432. Used ONLY by migrations, which
#                 issue DDL and hold long sessions that PgBouncer cannot carry.
#                 Omitting it makes `prisma migrate` hang or fail obscurely.
#
# These contain your database password — a real secret, unlike the keys above.
# Keep them in .env.local (gitignored). Never expose them to the browser and
# never prefix them with NEXT_PUBLIC_.
DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# The site's public address, e.g. "https://typeronin.com".
#
# Used for the sitemap, robots.txt and Open Graph image URLs — all three need an
# absolute address and none of them can work one out from a request. On Vercel,
# the production URL is picked up automatically and this can be left unset until
# there is a custom domain; set it the moment there is one, because the platform
# variable never learns about it. Locally it falls back to localhost:3000.
NEXT_PUBLIC_SITE_URL=""

# ---------------------------------------------------------------------------
# Advertising (optional). Leave unset and the ad slots render a house
# placeholder instead — no third-party script is loaded at all.
#
# Setting this also turns on /ads.txt, which is generated from the id below.
# Google marks an account "Earnings at risk" until that file is reachable, so
# check https://your-domain/ads.txt returns a line once you go live.
#
# Only the PUBLISHER id lives here: it is per-deployment, and a staging build
# must never serve production units. Individual ad slots are database rows an
# admin edits, so no ad unit is ever hardcoded in a page.
# AdSense → Account → Settings → Account information.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
